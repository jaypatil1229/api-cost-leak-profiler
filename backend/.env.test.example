# Copy this file to .env.test, then replace the placeholder with a random local-only password.
# Use a URL-safe password (for example, random hexadecimal) because it is embedded in DATABASE_URL.
ACLP_TEST_POSTGRES_PASSWORD=replace-with-random-local-test-password
DATABASE_URL=postgresql://aclp_test:replace-with-random-local-test-password@127.0.0.1:55432/aclp_test?schema=public
ACLP_TEST_BASE_URL=http://127.0.0.1:3000
ACLP_TEST_API_KEY=
ACLP_TEST_PROJECT_ID=
ACLP_TEST_ORG_ID=
