// =============================================================================
// ACLP (API Cost Leak Profiler) — Prisma schema
// -----------------------------------------------------------------------------
// Conventions
//  * Primary keys are UUIDs (`@db.Uuid`) generated by the database.
//  * Prisma DEFAULT naming is used: PascalCase tables, camelCase columns
//    (quoted identifiers in Postgres). Raw SQL in the codebase quotes
//    identifiers accordingly.
//  * All monetary values are `Decimal(20, 10)` — never floats. Decimals are
//    serialised to JSON as strings (see DecimalSerializerInterceptor).
//  * Every customer-owned row carries `organizationId`; project-scoped rows
//    additionally carry `projectId`. Tenant isolation is enforced in the
//    service/query layer, never from a client-supplied organizationId.
//  * Prompt/completion *content* is never stored — only hashes and counts.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationPlan {
  FREE
  PRO
  ENTERPRISE
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ProjectEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
  OTHER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

/// Scopes granted to an SDK API key. Keys are NOT user credentials.
enum ApiKeyScope {
  USAGE_WRITE
  USAGE_READ
}

enum Provider {
  OPENAI
  GEMINI
}

/// Outcome of the customer's provider call, as reported by the SDK.
enum CallStatus {
  SUCCESS
  ERROR
  TIMEOUT
  RATE_LIMITED
  CANCELLED
  UNKNOWN
}

/// Whether an estimated cost could be computed for a usage record.
enum CostStatus {
  /// Cost computed from a stored ModelPricing row.
  CALCULATED
  /// No pricing row matched (provider/model/date). Cost fields are NULL and the
  /// record can be re-priced later. This is NEVER a guessed value.
  PENDING_PRICING
  /// Cost cannot be computed for this record (e.g. token counts unavailable).
  UNAVAILABLE
}

enum DetectorType {
  DUPLICATE_PROMPT
  RETRY_LOOP
  UNBOUNDED_CONTEXT
  OVERSIZED_PROMPT
  SPEND_SPIKE
  ANOMALY_ISOLATION_FOREST
  SEMANTIC_DUPLICATE
}

enum DetectorKind {
  /// Runs inside the Node backend, no external dependency.
  DETERMINISTIC
  /// Requires the separate Python analytics service.
  ADVANCED
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
  FALSE_POSITIVE
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum AlertCategory {
  COST_LEAK
  SPEND_SPIKE
  ANOMALY
  SYSTEM
}

enum DetectionRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum DetectionEngine {
  NODE
  PYTHON
}

enum IngestionBatchStatus {
  ACCEPTED
  PARTIAL
  REJECTED
}

enum ReportType {
  OVERVIEW
  COST
  USAGE
  DETECTIONS
}

enum AuditActorType {
  USER
  API_KEY
  SYSTEM
}

enum VerificationTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// =============================================================================
// Identity
// =============================================================================

model User {
  id String @id @default(uuid()) @db.Uuid

  /// Normalised (trimmed + lower-cased) email. Uniqueness is on the normalised value.
  email        String     @unique @db.VarChar(320)
  name         String     @db.VarChar(120)
  /// Argon2id hash. Never selected into an API response.
  passwordHash String
  status       UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        OrganizationMembership[]
  ownedOrganizations Organization[]           @relation("OrganizationOwner")
  createdProjects    Project[]                @relation("ProjectCreatedBy")
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  sentInvitations    OrganizationInvitation[] @relation("InvitationInvitedBy")
  acceptedInvitation OrganizationInvitation[] @relation("InvitationAcceptedBy")
  createdApiKeys     ApiKey[]                 @relation("ApiKeyCreatedBy")
  revokedApiKeys     ApiKey[]                 @relation("ApiKeyRevokedBy")
  auditLogs          AuditLog[]
  savedReports       SavedReport[]
  acknowledgedAlerts Alert[]                  @relation("AlertAcknowledgedBy")
  resolvedAlerts     Alert[]                  @relation("AlertResolvedBy")
  acknowledgedFinds  DetectionFinding[]       @relation("FindingAcknowledgedBy")
  resolvedFindings   DetectionFinding[]       @relation("FindingResolvedBy")
  triggeredRuns      DetectionRun[]           @relation("DetectionRunTriggeredBy")

  @@index([status])
}

/// Long-lived opaque refresh tokens. Only a SHA-256 hash of the secret part is
/// stored. Rotation is family-based: reusing a rotated/revoked token revokes the
/// entire family (reuse detection).
model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Shared across every token produced by one login chain.
  familyId  String @db.Uuid
  /// SHA-256 of the token secret. Unique so a hash collision cannot alias sessions.
  tokenHash String @unique

  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?   @db.VarChar(64)
  /// Set when this token was rotated; points at its successor.
  replacedById  String?   @db.Uuid

  userAgent String? @db.VarChar(512)
  ipAddress String? @db.VarChar(64)

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId, familyId])
  @@index([familyId])
  @@index([expiresAt])
}

/// Scaffolded support for email verification and password reset.
/// NOTE: no email transport is implemented — see README "Extension points".
model VerificationToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose   VerificationTokenPurpose
  tokenHash String                   @unique

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

// =============================================================================
// Tenancy
// =============================================================================

model Organization {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  /// URL-safe unique identifier.
  slug String @unique @db.VarChar(64)

  plan   OrganizationPlan   @default(FREE)
  status OrganizationStatus @default(ACTIVE)

  /// Denormalised pointer to the current OWNER. Kept in sync with the OWNER
  /// membership inside a transaction (creation + ownership transfer).
  ownerUserId String @db.Uuid
  owner       User   @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   OrganizationMembership[]
  invitations   OrganizationInvitation[]
  projects      Project[]
  apiKeys       ApiKey[]
  usageRecords  UsageRecord[]
  findings      DetectionFinding[]
  alerts        Alert[]
  savedReports  SavedReport[]
  auditLogs     AuditLog[]
  batches       IngestionBatch[]
  detectionRuns DetectionRun[]

  @@index([ownerUserId])
  @@index([status])
}

model OrganizationMembership {
  id String @id @default(uuid()) @db.Uuid

  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role   OrgRole          @default(MEMBER)
  status MembershipStatus @default(ACTIVE)

  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@index([organizationId, status])
  @@index([userId])
}

/// Invitation to join an organization. Only the SHA-256 hash of the invitation
/// token is stored; the raw token is returned once to the inviter.
/// Application logic guarantees at most one PENDING invitation per (org, email).
model OrganizationInvitation {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Normalised invitee email.
  email  String           @db.VarChar(320)
  role   OrgRole          @default(MEMBER)
  status InvitationStatus @default(PENDING)

  tokenHash String @unique

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  invitedByUserId String? @db.Uuid
  invitedBy       User?   @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  acceptedByUserId String? @db.Uuid
  acceptedBy       User?   @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([email, status])
  @@index([expiresAt])
}

/// A Project represents one customer application / integration surface.
model Project {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String             @db.VarChar(120)
  slug        String             @db.VarChar(64)
  description String?            @db.VarChar(1000)
  environment ProjectEnvironment @default(DEVELOPMENT)
  status      ProjectStatus      @default(ACTIVE)

  archivedAt DateTime?

  createdByUserId String? @db.Uuid
  createdBy       User?   @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiKeys       ApiKey[]
  usageRecords  UsageRecord[]
  findings      DetectionFinding[]
  alerts        Alert[]
  savedReports  SavedReport[]
  batches       IngestionBatch[]
  detectionRuns DetectionRun[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

// =============================================================================
// SDK credentials
// =============================================================================

/// SDK ingestion credential. Distinct from user JWTs: an ApiKey authenticates a
/// *project*, never a person. Raw keys are shown exactly once at creation.
/// Stored form: public `keyPrefix` (lookup) + HMAC-SHA256 of the secret part.
model ApiKey {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String       @db.Uuid
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name String @db.VarChar(120)

  /// Public, non-secret identifier embedded in the raw key. Used for O(1) lookup.
  keyPrefix String @unique @db.VarChar(64)
  /// HMAC-SHA256(secret, API_KEY_HMAC_SECRET), hex encoded.
  keyHash   String @db.VarChar(128)

  scopes ApiKeyScope[]

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  /// When this key was created by rotating another key.
  rotatedFromKeyId String? @db.Uuid

  createdByUserId String? @db.Uuid
  createdBy       User?   @relation("ApiKeyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  revokedByUserId String? @db.Uuid
  revokedBy       User?   @relation("ApiKeyRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usageRecords UsageRecord[]
  batches      IngestionBatch[]

  @@index([projectId, revokedAt])
  @@index([organizationId])
}

// =============================================================================
// Pricing
// =============================================================================

/// Versioned provider pricing. Selection rule for a usage record at time T:
///   provider = P AND model = M
///   AND effectiveFrom <= T
///   AND (effectiveTo IS NULL OR effectiveTo > T)
///   ORDER BY effectiveFrom DESC LIMIT 1
/// Overlapping windows for the same (provider, model) are rejected by
/// PricingService before insert; the ordering above makes selection
/// deterministic even if overlaps are introduced out-of-band.
model ModelPricing {
  id String @id @default(uuid()) @db.Uuid

  provider Provider
  model    String   @db.VarChar(120)

  inputRatePerMillionTokens       Decimal  @db.Decimal(20, 10)
  outputRatePerMillionTokens      Decimal  @db.Decimal(20, 10)
  cachedInputRatePerMillionTokens Decimal? @db.Decimal(20, 10)

  currency String @default("USD") @db.VarChar(3)

  /// Human-readable pricing revision label, e.g. "2026-01-openai-public".
  version String  @db.VarChar(64)
  /// Where the rate came from (URL / document reference).
  source  String? @db.VarChar(512)
  notes   String? @db.VarChar(1000)

  /// FALSE for development/example data. Unverified rates are still used for
  /// estimation but are flagged in API responses so they are never mistaken
  /// for authoritative provider pricing.
  isVerified Boolean @default(false)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usageRecords UsageRecord[]

  @@unique([provider, model, version])
  @@index([provider, model, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
}

// =============================================================================
// Ingestion & usage
// =============================================================================

/// Metadata for one batch ingestion request. Used for observability and for
/// correlating per-event outcomes; not required for deduplication (that is done
/// per event via `eventId`).
model IngestionBatch {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String       @db.Uuid
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  apiKeyId String? @db.Uuid
  apiKey   ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  /// Optional client-supplied batch identifier (idempotency aid for retries).
  clientBatchId String? @db.VarChar(128)

  eventCount     Int
  acceptedCount  Int @default(0)
  duplicateCount Int @default(0)
  rejectedCount  Int @default(0)

  status IngestionBatchStatus @default(ACCEPTED)

  sdkName    String? @db.VarChar(64)
  sdkVersion String? @db.VarChar(32)

  receivedAt DateTime @default(now())

  usageRecords UsageRecord[]

  @@unique([projectId, clientBatchId])
  @@index([projectId, receivedAt])
}

/// One observed LLM provider call. ACLP never sees the provider request itself —
/// this is metadata reported by the customer's SDK after the fact.
model UsageRecord {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String       @db.Uuid
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// SDK-supplied idempotency key. Unique per project.
  eventId String @db.VarChar(128)

  /// Provider-side request id (e.g. OpenAI `x-request-id`), when the SDK has it.
  externalRequestId String? @db.VarChar(128)

  provider Provider
  model    String   @db.VarChar(120)

  /// When the provider call happened (client clock, validated for sanity).
  occurredAt DateTime
  /// When ACLP received the event (server clock).
  receivedAt DateTime @default(now())

  inputTokens       Int
  outputTokens      Int
  /// input + output unless the SDK reports an authoritative total.
  totalTokens       Int
  /// Cached//reused prompt tokens reported by the provider, when available.
  cachedInputTokens Int?

  latencyMs Int?
  status    CallStatus @default(SUCCESS)
  errorCode String?    @db.VarChar(64)

  // ---- attribution dimensions (all customer-supplied, all optional) --------
  /// Customer's feature / code-path label.
  featureId      String? @db.VarChar(128)
  /// Customer's own end-user identifier. NOT an ACLP login user.
  customerUserId String? @db.VarChar(128)
  sessionId      String? @db.VarChar(128)

  // ---- privacy-preserving prompt fingerprints ------------------------------
  /// Hash of the prompt computed by the SDK. Raw prompt text is never stored.
  promptHash          String? @db.VarChar(128)
  promptCharCount     Int?
  completionCharCount Int?

  // ---- estimated cost ------------------------------------------------------
  estimatedInputCost  Decimal?   @db.Decimal(20, 10)
  estimatedOutputCost Decimal?   @db.Decimal(20, 10)
  estimatedTotalCost  Decimal?   @db.Decimal(20, 10)
  currency            String     @default("USD") @db.VarChar(3)
  costStatus          CostStatus @default(PENDING_PRICING)

  modelPricingId String?       @db.Uuid
  modelPricing   ModelPricing? @relation(fields: [modelPricingId], references: [id], onDelete: SetNull)
  /// Copy of ModelPricing.version at computation time (survives pricing deletion).
  pricingVersion String?       @db.VarChar(64)

  /// Sanitised, size-limited key/value metadata. Never prompt or completion text.
  metadata Json?

  sdkName    String? @db.VarChar(64)
  sdkVersion String? @db.VarChar(32)

  apiKeyId String? @db.Uuid
  apiKey   ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  ingestionBatchId String?         @db.Uuid
  ingestionBatch   IngestionBatch? @relation(fields: [ingestionBatchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  findingLinks FindingUsageLink[]

  @@unique([projectId, eventId])
  @@index([organizationId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([projectId, provider, occurredAt])
  @@index([projectId, model, occurredAt])
  @@index([projectId, featureId, occurredAt])
  @@index([projectId, customerUserId, occurredAt])
  @@index([projectId, sessionId, occurredAt])
  @@index([projectId, promptHash, occurredAt])
  @@index([projectId, status, occurredAt])
  @@index([projectId, costStatus])
}

// =============================================================================
// Detection & alerting
// =============================================================================

/// One execution of one detector over one time window.
model DetectionRun {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String       @db.Uuid
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  detectorType    DetectorType
  detectorVersion String             @db.VarChar(32)
  engine          DetectionEngine    @default(NODE)
  status          DetectionRunStatus @default(PENDING)

  windowStart DateTime
  windowEnd   DateTime

  startedAt   DateTime?
  completedAt DateTime?

  recordsScanned  Int @default(0)
  findingsCreated Int @default(0)

  error String? @db.VarChar(2000)

  triggeredByUserId String? @db.Uuid
  triggeredBy       User?   @relation("DetectionRunTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  findings DetectionFinding[]

  @@index([projectId, detectorType, createdAt])
  @@index([organizationId, status])
}

model DetectionFinding {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String       @db.Uuid
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  detectorType    DetectorType
  detectorVersion String       @db.VarChar(32)

  status   FindingStatus @default(OPEN)
  severity Severity      @default(MEDIUM)

  title       String @db.VarChar(200)
  explanation String @db.Text

  /// Detector-specific structured evidence. Shape is validated per detector by
  /// the evidence contracts in src/modules/detection/contracts.
  evidence Json

  estimatedRecoverableCost Decimal? @db.Decimal(20, 10)
  currency                 String   @default("USD") @db.VarChar(3)

  /// Stable dedupe key produced by the detector (e.g. hash of prompt + window).
  fingerprint String @db.VarChar(128)

  windowStart DateTime?
  windowEnd   DateTime?

  detectedAt DateTime @default(now())

  acknowledgedAt       DateTime?
  acknowledgedByUserId String?   @db.Uuid
  acknowledgedBy       User?     @relation("FindingAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)

  resolvedAt       DateTime?
  resolvedByUserId String?   @db.Uuid
  resolvedBy       User?     @relation("FindingResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  detectionRunId String?       @db.Uuid
  detectionRun   DetectionRun? @relation(fields: [detectionRunId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usageLinks FindingUsageLink[]
  alerts     Alert[]

  @@unique([projectId, detectorType, fingerprint])
  @@index([organizationId, status, severity])
  @@index([projectId, detectedAt])
  @@index([projectId, detectorType, status])
}

/// Join table linking a finding to the usage records that evidence it.
model FindingUsageLink {
  id String @id @default(uuid()) @db.Uuid

  findingId String           @db.Uuid
  finding   DetectionFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  usageRecordId String      @db.Uuid
  usageRecord   UsageRecord @relation(fields: [usageRecordId], references: [id], onDelete: Cascade)

  /// e.g. "primary" | "duplicate" | "retry" — detector defined.
  role String? @db.VarChar(32)

  createdAt DateTime @default(now())

  @@unique([findingId, usageRecordId])
  @@index([usageRecordId])
}

model Alert {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// NULL for organization-wide alerts.
  projectId      String?      @db.Uuid
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  findingId String?           @db.Uuid
  finding   DetectionFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)

  category AlertCategory
  severity Severity      @default(MEDIUM)
  status   AlertStatus   @default(OPEN)

  title   String @db.VarChar(200)
  message String @db.Text

  evidence Json?

  estimatedRecoverableCost Decimal? @db.Decimal(20, 10)
  currency                 String   @default("USD") @db.VarChar(3)

  acknowledgedAt       DateTime?
  acknowledgedByUserId String?   @db.Uuid
  acknowledgedBy       User?     @relation("AlertAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)

  resolvedAt       DateTime?
  resolvedByUserId String?   @db.Uuid
  resolvedBy       User?     @relation("AlertResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([findingId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, severity, status])
  @@index([projectId, status, createdAt])
}

// =============================================================================
// Reporting & audit
// =============================================================================

/// A stored report *definition* (filters + type). Report data is always computed
/// on read; no materialised snapshots and no scheduling in this phase.
model SavedReport {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// NULL for organization-wide reports.
  projectId      String?      @db.Uuid
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String     @db.VarChar(120)
  description String?    @db.VarChar(1000)
  type        ReportType

  /// Validated against the report filter DTO before persistence.
  config Json

  createdByUserId String? @db.Uuid
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, type])
}

/// Append-only audit trail. Never contains secrets, tokens or raw credentials.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// NULL for system-level events with no organization context.
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  actorType     AuditActorType @default(USER)
  actorUserId   String?        @db.Uuid
  actorUser     User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Set when the actor was an SDK API key (no FK: keys may be hard-deleted).
  actorApiKeyId String?        @db.Uuid

  /// Dotted action name, e.g. "organization.member.role_changed".
  action String @db.VarChar(100)

  resourceType String  @db.VarChar(64)
  resourceId   String? @db.VarChar(64)

  /// Sanitised context (ids, before/after enum values). Never secrets.
  metadata Json?

  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(512)
  requestId String? @db.VarChar(64)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
}
