# =============================================================================
# ACLP Backend — example environment file
# Copy to `.env` and replace every placeholder. NEVER commit a real .env file.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =============================================================================

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public base URL of this API (used in Swagger servers and invitation links).
APP_URL=http://localhost:3000
# Set to true only when running behind a trusted reverse proxy / load balancer.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Logging (pino). Secrets are redacted by the logger; see src/config.
# ---------------------------------------------------------------------------
LOG_LEVEL=debug
# Human-readable logs for local development. Use false (JSON) in production.
LOG_PRETTY=true

# ---------------------------------------------------------------------------
# Database (PostgreSQL). Leave blank in development to boot without a DB:
# database-backed routes then return 503 SERVICE_UNAVAILABLE.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://aclp:aclp_local_password@localhost:5432/aclp?schema=public
# When true the process refuses to start without a reachable DATABASE_URL.
# Defaults: false in development/test, true in production.
# REQUIRE_DATABASE=true

# ---------------------------------------------------------------------------
# Authentication
# Access token  = short-lived signed JWT (HS256).
# Refresh token = long-lived opaque rotating token, stored only as a SHA-256 hash.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-me-with-a-long-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-long-random-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
JWT_ISSUER=aclp
JWT_AUDIENCE=aclp-api

# Pepper used to HMAC SDK API key secrets before storage. Rotating this value
# invalidates every existing API key.
API_KEY_HMAC_SECRET=replace-me-with-a-long-random-api-key-pepper-min-32-chars

# Create a personal organization automatically on registration.
AUTO_CREATE_ORGANIZATION_ON_REGISTER=true
# Organization invitation validity window.
INVITATION_TTL_HOURS=168

# ---------------------------------------------------------------------------
# HTTP security
# ---------------------------------------------------------------------------
# Comma-separated allowlist. Use "*" ONLY for local development.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Max JSON body size for normal API routes and for ingestion routes.
BODY_LIMIT=256kb
INGEST_BODY_LIMIT=1mb

# ---------------------------------------------------------------------------
# Rate limiting (in-memory; per process — see README for multi-instance notes)
# TTL values are in milliseconds.
# ---------------------------------------------------------------------------
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=300
AUTH_RATE_LIMIT_TTL=60000
AUTH_RATE_LIMIT_LIMIT=10
INGEST_RATE_LIMIT_TTL=60000
INGEST_RATE_LIMIT_LIMIT=600

# ---------------------------------------------------------------------------
# Ingestion / query limits
# ---------------------------------------------------------------------------
INGEST_MAX_BATCH_SIZE=500
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=200
# Maximum span (in days) allowed for a single analytics/report query window.
MAX_QUERY_WINDOW_DAYS=366
# Throttle window for UsageRecord-driven ApiKey.lastUsedAt writes.
API_KEY_LAST_USED_THROTTLE_SECONDS=300

# ---------------------------------------------------------------------------
# Python analytics service (implemented separately; optional at boot)
# ---------------------------------------------------------------------------
ANALYTICS_SERVICE_URL=
ANALYTICS_SERVICE_TOKEN=
ANALYTICS_SERVICE_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# API documentation
# ---------------------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
