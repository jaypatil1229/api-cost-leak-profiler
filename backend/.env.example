# =============================================================================
# ACLP Backend Environment Configuration
# =============================================================================
# Copy this file to .env and replace placeholders with actual values.
# Never commit .env to version control — it contains secrets.
#
# To generate secure random secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# =============================================================================
# Application
# =============================================================================

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3001
TRUST_PROXY=True

# =============================================================================
# Logging
# =============================================================================

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
LOG_PRETTY=true

# =============================================================================
# Database
# =============================================================================

# Leave blank to boot without a database (dev only).
DATABASE_URL=
REQUIRE_DATABASE=true

# =============================================================================
# Authentication & Authorization
# =============================================================================

# At least 32 characters. MUST differ from JWT_REFRESH_SECRET in production.
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING_HERE
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_LONG_RANDOM_STRING
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
JWT_ISSUER=aclp
JWT_AUDIENCE=aclp-api
API_KEY_HMAC_SECRET=CHANGE_ME_GENERATE_ANOTHER_LONG_RANDOM_STRING
AUTO_CREATE_ORGANIZATION_ON_REGISTER=true
INVITATION_TTL_HOURS=168

# =============================================================================
# HTTP & CORS
# =============================================================================

# Comma-separated. Use "*" in development only. MUST NOT be "*" in production.
CORS_ORIGINS=http://localhost:3001,http://localhost:4173
BODY_LIMIT=256kb
INGEST_BODY_LIMIT=1mb

# =============================================================================
# Rate Limiting (in-memory, per-instance)
# =============================================================================

RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=300
AUTH_RATE_LIMIT_TTL=60000
AUTH_RATE_LIMIT_LIMIT=10
INGEST_RATE_LIMIT_TTL=60000
INGEST_RATE_LIMIT_LIMIT=600

# =============================================================================
# Limits & Pagination
# =============================================================================

INGEST_MAX_BATCH_SIZE=500
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=200
MAX_QUERY_WINDOW_DAYS=366
API_KEY_LAST_USED_THROTTLE_SECONDS=300

# =============================================================================
# Analytics Service (Optional Python Service)
# =============================================================================

# Run analytics/docker-compose.yml locally; the service is bound to loopback.
ANALYTICS_SERVICE_URL=http://127.0.0.1:8000
# Set this to the same random key as analytics/.env ANALYTICS_SERVICE_KEY.
ANALYTICS_SERVICE_TOKEN=
ANALYTICS_SERVICE_TIMEOUT_MS=15000

# =============================================================================
# Documentation
# =============================================================================

SWAGGER_ENABLED=true
SWAGGER_PATH=docs