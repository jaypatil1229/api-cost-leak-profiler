{
  "name": "@aclp/telemetry-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for submitting LLM usage telemetry to ACLP",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md"],
  "engines": { "node": ">=20.11.0" },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:live": "npm run build && node --test test/live.integration.cjs",
    "example": "npm run build && node examples/submit-usage.cjs"
  },
  "devDependencies": { "typescript": "^5.8.2" }
}
