APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
ENABLE_SEMANTIC_ANALYSIS=false
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_SIMILARITY_THRESHOLD=0.80
MAX_SEMANTIC_RECORDS=5000
ANALYTICS_SERVICE_KEY=a49a9f29948ce8143c410fd66c78755b0d4c7401b76b757e1550852e81271be0
ALLOW_PROMPT_LOGGING=false

# Isolation Forest anomaly detector
IFOREST_N_ESTIMATORS=200
IFOREST_CONTAMINATION=auto
IFOREST_RANDOM_STATE=42
IFOREST_MAX_SAMPLES=auto
IFOREST_MIN_SAMPLES=10
IFOREST_MAX_RECORDS=5000
IFOREST_SEVERITY_HIGH_PERCENTILE=0.98
IFOREST_SEVERITY_MEDIUM_PERCENTILE=0.90
IFOREST_COST_ESCALATION_MULTIPLE=3.0
